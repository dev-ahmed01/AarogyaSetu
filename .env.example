# Local development defaults.
APP_ENV=local

POSTGRES_DB=aarogya
POSTGRES_USER=aarogya
POSTGRES_PASSWORD=aarogya_local
POSTGRES_PORT=5432

API_PORT=8080
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Replace with a unique random value of at least 64 characters in production.
JWT_SECRET=aarogya-local-development-secret-change-before-production-2026
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

AUTH_RATE_LIMIT_ATTEMPTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

DB_CONNECTION_TIMEOUT_MS=10000
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
DB_MAX_LIFETIME_MS=1800000

# Production guard:
# APP_ENV=production requires:
# - HTTPS CORS origins only (no localhost / wildcard)
# - COOKIE_SECURE=true
# - COOKIE_SAME_SITE=Lax or Strict
# - non-local DATABASE_URL / POSTGRES_PASSWORD
# - JWT_SECRET >= 64 chars and not the local default
#
# Because cookie-authenticated CSRF tokens are not implemented, do not use
# SameSite=None. Deploy the web and API on same-site HTTPS domains such as
# app.example.com and api.example.com.
